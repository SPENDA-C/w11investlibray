{
  "name": "@invest/batch",
  "version": "0.1.0",
  "private": true,
  "description": "重い処理（バックフィル・バックテスト・疎通確認）。GitHub Actions から回す",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/cli.ts --bundle --format=esm --platform=node --packages=external --outfile=.build/cli.mjs",
    "build:test": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "cli": "npm run build --silent && node .build/cli.mjs",
    "precheck:datasource": "npm run build --silent",
    "check:datasource": "node .build/cli.mjs check",
    "prebackfill": "npm run build --silent",
    "backfill": "node .build/cli.mjs backfill",
    "prebacktest": "npm run build --silent",
    "backtest": "node .build/cli.mjs backtest",
    "precheck:sheet": "npm run build --silent",
    "check:sheet": "node .build/cli.mjs check-sheet",
    "presheet": "npm run build --silent",
    "sheet": "node .build/cli.mjs sheet"
  },
  "dependencies": {
    "@invest/core": "*"
  }
}
